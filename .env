# ===== Required =====
# Base workspace directory — repos are auto-cloned into subfolders: ./workspace/<repo-name>/
AGENT_WORKDIR=./workspace

# ===== Session Secret (auto-generated if not set) =====
SECRET_KEY=

# ===== GitHub OAuth (required for user authentication) =====
# Create at: https://github.com/settings/developers → OAuth Apps
# Set callback URL to: http://localhost:8080/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Terraform apply mode: "pr" (default, creates PR for review) or "auto" (auto-approve non-destructive)
APPROVAL_MODE=pr

# ===== LLM Configuration (Amazon Bedrock — shared account) =====
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5
BEDROCK_REGION=eu-west-2

# Bedrock API key (Bearer token auth)
# Generate in AWS Console region eu-west-2 (London): Amazon Bedrock → API keys
# Paste ONLY the key (starts with bedrock-api-key-). Do not include "export ..."
AWS_BEARER_TOKEN_BEDROCK=

# ===== Server =====
MCP_PORT=8080
SERVER_HOST=0.0.0.0

# ===== Scheduled Drift Monitoring =====
DRIFT_CHECK_INTERVAL_MINUTES=30

# ===== Notifications (optional — set Slack webhook to receive drift alerts) =====
SLACK_WEBHOOK_URL=

# ===== Cost threshold in dollars (optional) =====
COST_THRESHOLD=100

# ===== AWS Credentials for Terraform Deployments =====
# Temporary credentials (access key + secret + session token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-south-1

# Terraform remote state (S3) — also configurable in Settings
TF_STATE_BUCKET=
TF_STATE_KEY=
TF_STATE_REGION=ap-south-1
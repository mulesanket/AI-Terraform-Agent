# ===== Required =====
# Base workspace directory. Generated Terraform and synced repos are stored here.
AGENT_WORKDIR=./workspace

# ===== Server =====
MCP_PORT=8080
SERVER_HOST=0.0.0.0

# API bearer token for non-browser/API access. Set this in production.
API_KEY=

# Flask session secret. Set this in production so sessions survive restarts.
SECRET_KEY=

# ===== GitHub OAuth (browser login) =====
# Create at: https://github.com/settings/developers -> OAuth Apps
# Local callback: http://localhost:8080/auth/oauth/github/callback
# EC2 callback:   http://<EC2-PUBLIC-IP>:8080/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== GitHub repo automation (optional but needed for PR/pipeline flows) =====
# Token should have repo access for the target infrastructure repository.
GITHUB_PAT=
GITHUB_REPO=

# Terraform apply mode: "pr" (default), "approval", or "auto".
APPROVAL_MODE=pr

# ===== LLM Configuration (Amazon Bedrock) =====
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5
BEDROCK_REGION=eu-west-2

# Bedrock API key (Bearer token auth).
# Generate at: AWS Console -> Amazon Bedrock -> API keys.
AWS_BEARER_TOKEN_BEDROCK=

# ===== Scheduled Drift Monitoring =====
DRIFT_CHECK_INTERVAL_MINUTES=30

# ===== Notifications (optional) =====
SLACK_WEBHOOK_URL=

# ===== Cost threshold in dollars =====
COST_THRESHOLD=100

# ===== AWS Credentials for Terraform Deployments =====
# Prefer EC2 instance profile/role on EC2. Leave keys empty when using a role.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# ===== Terraform remote state (S3) =====
# Written to backend.tf and used by GitHub Actions.
TF_STATE_BUCKET=
TF_STATE_KEY=
TF_STATE_REGION=us-east-1
